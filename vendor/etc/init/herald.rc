# herald.rc — Herald daemon for kernel-to-userspace property relay
#
# Starts herald.sh after sys.boot_completed=1 so that
# setprop(1) is fully available.  The daemon polls the Herald
# kernel queue and applies pending property changes.

service herald-daemon /vendor/etc/herald.sh
    class main
    user root
    group root
    oneshot
    disabled

on property:sys.boot_completed=1
    start herald-daemon
